@page "{id:int}"
@model ACE_Deployment_Tracking.Pages.DeploymentPlan.DeploymentStartModel
@{
	ViewData["Title"] = "Deployment Start";
}

<div class="container mt-4">

	<h5 class="fw-bold mb-4">
		Actual Hour
	</h5>

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="card shadow-sm border-0 rounded-4 p-4" style="max-width: 650px;">
            <div class="row mb-3 align-items-center">
                <label class="col-sm-3 col-form-label text-sm-center">Actual From Time</label>
                <div class="col-sm-5">
                    <input type="time"
                           class="form-control bg-light"
                           id="fromTime"
                           asp-for="ActualFromTime" />
                </div>
            </div>

            <div class="row mb-3 align-items-center">
                <label class="col-sm-3 col-form-label text-sm-center">Actual To Time</label>
                <div class="col-sm-5">
                    <input type="time"
                           class="form-control bg-light"
                           id="toTime"
                           asp-for="ActualToTime" />
                </div>
            </div>

            <div class="row mb-3 align-items-center">
                <label class="col-sm-3 col-form-label text-sm-center">Actual Time Duration</label>
                <div class="col-sm-5">
                    <input type="text"
                           class="form-control bg-light"
                           id="timeDuration"
                           asp-for="ActualHour"
                           placeholder="HH"
                           readonly />
                </div>
            </div>

            <div class="mt-4 ms-3">

                <button type="submit"
                        class="btn btn-primary px-5 me-4">

                    Update

                </button>

                <a asp-page="/Deployment/DeploymentSchedule"
                       class="btn btn-secondary px-5">

                    Cancel

                </a>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const fromTime = document.getElementById('fromTime');
        const toTime = document.getElementById('toTime');
        const duration = document.getElementById('timeDuration');

        function calculateDuration() {

            if (fromTime.value && toTime.value) {

                const from = new Date(`2000-01-01T${fromTime.value}`);
                const to = new Date(`2000-01-01T${toTime.value}`);

                let diff = (to - from) / 1000 / 60 / 60;

                if (diff < 0) {
                    diff += 24;
                }

                duration.value = parseFloat(diff).toFixed(2);
            }
        }

        fromTime.addEventListener('change', calculateDuration);
        toTime.addEventListener('change', calculateDuration);

        calculateDuration();
    </script>
}
