@page
@model DeploymentScheduleModel
@{
    ViewData["Title"] = "Deployment Schedule";
}
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<form method="get" class="row g-3 mb-4 align-items-end">

    <div class="col-md-3">
        <label class="form-label">System Name</label>

        <select asp-for="SystemName" class="form-select">

            <option value="">All Systems</option>

            @foreach (var system in Model.SystemNames)
            {
                <option value="@system">@system</option>
            }

        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Status</label>

        <select asp-for="Status" class="form-select">

            <option value="">All Status</option>

            <option value="Planned">Planned</option>
            <option value="Done">Done</option>
            <option value="Canceled">Canceled</option>

        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">From Date</label>

        <input asp-for="FromDate"
               type="date"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">To Date</label>

        <input asp-for="ToDate"
               type="date"
               class="form-control" />
    </div>

    <div class="col-md-3 d-flex gap-2">

        <button type="submit"
                class="btn btn-primary w-100">

            Search

        </button>

        <a asp-page="/Deployment/DeploymentSchedule"
               class="btn btn-secondary w-100">

            Reset

        </a>

    </div>

</form>

<div class="schedule-wrapper">
    <div class="schedule-card">
        <table class="schedule-table">
            <thead class="table-light">
                <tr>
                    <th>System</th>
                    <th>Planned Date</th>
                    <th>Estimated Hour</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>
                @if(Model.DeploymentSchedules != null && Model.DeploymentSchedules.Any())
                {
                    @foreach (var item in Model.DeploymentSchedules)
                    {
                        <tr>
                            <td>@item.SystemName</td>
                            <td>@(item.PlannedDate.HasValue ? item.PlannedDate.Value.ToString("yyyy-MM-dd") : "")</td>
                            <td>@item.EstimatedHour @(item.EstimatedHour > 1 ? "Hours" : "Hour")</td>
                            <td>@item.Status</td>

                            <td>
                                @if (item.Status == "Planned")
                                {
                                    <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">

                                        <a asp-page="/Deployment/StartDeployment"
                                               asp-route-id="@item.Id"
                                               class="btn btn-primary">
                                            Start Deployment
                                        </a>

                                        <a asp-page="/DeploymentPlan/Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-success">
                                            Edit
                                        </a>

                                        <button type="button" class="btn btn-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                            Delete
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <a asp-page="/DeploymentPlan/Detail"
                                           asp-route-id="@item.Id"
                                           class="fw-bold text-primary text-decoration-none">
                                        View Detail
                                    </a>
                                }
                            </td>
                        </tr>

                        <div class="modal fade"
                             id="deleteModal-@item.Id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title">Delete Schedule</h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>
                                    </div>

                                    <div class="modal-body">
                                        Are you sure you want to delete this schedule?
                                    </div>

                                    <div class="modal-footer">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form method="post" asp-page-handler="Delete">
                                            <input type="hidden" name="id" value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Yes, Delete
                                            </button>
                                        </form>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }   
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 fw-bold text-secondary">
                            There is no data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>